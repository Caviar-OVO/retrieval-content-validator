# Template for Streamlit Community Cloud secrets.
# On share.streamlit.io: App -> Settings -> Secrets -> paste the lines below
# (with your real values). Do NOT commit a filled-in `secrets.toml`.
# `rva/config.py` bridges these into the environment automatically in the cloud.

OPENAI_API_KEY = ""
# Optional: OpenAI-compatible endpoint / proxy
# OPENAI_BASE_URL = "https://..."
# RVA_JUDGE_MODEL = "gpt-4o-mini"
# RVA_CRITIC = "auto"      # llm only when a key AND sources are present
# RVA_REVISER = "local"
