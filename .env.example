# Template for Response Validation Agent configuration.
# Copy to `.env` and fill in your key:
#   Copy-Item .env.example .env
OPENAI_API_KEY=
OPENAI_BASE_URL=
RVA_JUDGE_MODEL=gpt-4o-mini
RVA_JUDGE=local

# Stage 2: vector retrieval + three-way NLI.
# hash/heuristic run fully offline; openai/llm need a key + network.
RVA_RETRIEVER=hash
RVA_NLI=heuristic
RVA_EMBED_MODEL=text-embedding-3-small
RVA_DOMAIN=general

# Optional: produce a revised answer by default (the original is never mutated).
RVA_REVISE=0
# Critic backend: deterministic = offline rule-based critic (default, auditable);
# llm = Critic persona (extraction + five-level verdict in one pass);
# auto = llm only when BOTH OPENAI_API_KEY and sources are present, else deterministic.
# auto/llm are the only tracks that use a key (OPENAI_API_KEY above); with a key but
# no sources, auto still does NOT take the LLM track (strict source-gating).
# An explicit value beats auto; RVA_CRITIC=deterministic fully disables the LLM track.
RVA_CRITIC=deterministic
# Revision backend: local = deterministic offline rewriter (default, auditable);
# llm = editor-persona LLM reviser (needs a key); auto = llm when a key is present.
RVA_REVISER=local
# Revision->recheck gate: re-run source-anchored factuality on the revised text.
RVA_RECHECK=1
RVA_RECHECK_THRESHOLD=0.7
RVA_RECHECK_MAX_ROUNDS=2
